{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "PicNexus main window capability: plugin permissions plus every app command (allow-<command>) its own UI calls",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-clear-all-browsing-data",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-write-text-file",
    "fs:scope-app-recursive",
    "fs:scope-appcache-recursive",
    "fs:scope-appconfig-recursive",
    "fs:scope-appdata-recursive",
    "fs:scope-applocaldata-recursive",
    "fs:scope-applog-recursive",
    "fs:scope-temp-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        "$RESOURCE/data",
        "$RESOURCE/data/**"
      ]
    },
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://sm.ms/*" },
        { "url": "https://api.imgur.com/*" },
        { "url": "https://www.baidu.com/*" },
        { "url": "https://www.qq.com/*" },
        { "url": "https://www.cloudflare.com/*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" }
      ]
    },
    "positioner:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "updater:default",
    "process:allow-restart",
    "log:default",
    "allow-set-close-to-tray",
    "allow-get-user-data-dir",
    "allow-get-history-db-path",
    "allow-analytics-send-batch",
    "allow-analytics-shutdown",
    "allow-analytics-start-heartbeat",
    "allow-analytics-stop-heartbeat",
    "allow-open-login-window",
    "allow-test-r2-connection",
    "allow-test-webdav-connection",
    "allow-upload-file-stream",
    "allow-test-weibo-connection",
    "allow-upload-to-jd",
    "allow-check-jd-available",
    "allow-upload-to-nowcoder",
    "allow-test-nowcoder-cookie",
    "allow-upload-to-qiyu",
    "allow-check-chrome-installed",
    "allow-check-qiyu-available",
    "allow-upload-to-zhihu",
    "allow-test-zhihu-connection",
    "allow-upload-to-nami",
    "allow-test-nami-connection",
    "allow-fetch-nami-token",
    "allow-upload-to-bilibili",
    "allow-test-bilibili-connection",
    "allow-upload-to-chaoxing",
    "allow-test-chaoxing-connection",
    "allow-get-cli-path-status",
    "allow-add-cli-to-path",
    "allow-remove-cli-from-path",
    "allow-upload-to-smms",
    "allow-upload-to-github",
    "allow-upload-to-imgur",
    "allow-upload-to-s3-compatible",
    "allow-probe-s3-storage",
    "allow-upload-to-webdav",
    "allow-test-webdav-storage",
    "allow-check-image-link",
    "allow-download-url-image",
    "allow-batch-check-links",
    "allow-cancel-batch-check",
    "allow-pause-batch-check",
    "allow-resume-batch-check",
    "allow-clipboard-has-image",
    "allow-read-clipboard-image",
    "allow-set-clipboard-watch",
    "allow-cleanup-clipboard-temp-file",
    "allow-export-text-file",
    "allow-import-text-file",
    "allow-cleanup-owned-temp-file",
    "allow-allow-user-path",
    "allow-get-image-metadata",
    "allow-compress-image",
    "allow-cleanup-compressed-files",
    "allow-strip-exif-only",
    "allow-read-image-as-base64",
    "allow-scan-md-folder",
    "allow-get-or-create-secure-key",
    "allow-set-secure-key",
    "allow-open-log-dir",
    "allow-webdav-request",
    "allow-open-path",
    "allow-check-port-free",
    "allow-check-editor-server-status",
    "allow-update-server-config",
    "allow-save-cli-config",
    "allow-get-executable-path"
  ]
}
